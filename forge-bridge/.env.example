# ==============================================================================
# FORGE LOCAL BRIDGE — CONFIGURACIÓN DE ENTORNO LOCAL (WINDOWS)
# ==============================================================================
# Copia este archivo a `.env` y ajusta las variables según tu entorno.
# NUNCA subas tu archivo `.env` real al repositorio.

# 1. Endpoint remoto de Forge AI Studio (Google AI Studio Build / Cloud Run)
# En desarrollo local puedes apuntar a http://127.0.0.1:3000 o http://127.0.0.1:8000
FORGE_CLOUD_URL="http://127.0.0.1:3000"

# 2. Secreto compartido entre Forge Cloud y el Puente Local (Autenticación HMAC + Sesión)
# Genera un secreto aleatorio de 32 bytes: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FORGE_BRIDGE_SHARED_SECRET=""

# 3. Token local exigido al Plugin de Roblox Studio para comunicarse con 127.0.0.1
# Configura el mismo token en el widget del Plugin de Roblox Studio.
FORGE_PLUGIN_LOCAL_TOKEN=""

# 4. Ruta local del proyecto Rojo en tu PC Windows (SOLO existe en Windows, nunca se envía a la nube)
ROJO_PROJECT_PATH="../"

# 5. Host y puerto exclusivos de loopback donde escucha el Puente Local
BRIDGE_HOST="127.0.0.1"
BRIDGE_PORT="48720"

# 6. Puerto local del servidor Rojo (`rojo serve`)
ROJO_PORT="34872"

# 7. Parámetros de cola, concurrencia, heartbeat y seguridad
BRIDGE_HEARTBEAT_INTERVAL_MS="2500"
BRIDGE_TASK_TIMEOUT_MS="30000"
BRIDGE_MAX_CONCURRENCY="2"
BRIDGE_MAX_FILE_SIZE_BYTES="15728640"
BRIDGE_MAX_RETRIES="3"
