# ==============================================================================
# Forge AI - Roblox & Rojo Backend Configuration
# ==============================================================================

# Your Google Gemini API Key (Obtain from Google AI Studio: https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Absolute or relative path to your local Rojo project root directory.
# Example: C:/Users/Username/Documents/RobloxProjects/MyGame
# The server will automatically write to:
#   $ROJO_PROJECT_PATH/src/server/
#   $ROJO_PROJECT_PATH/src/client/
#   $ROJO_PROJECT_PATH/src/shared/
#   $ROJO_PROJECT_PATH/src/client/UI/
ROJO_PROJECT_PATH=./rojo_workspace

# Gemini Model Selection Tiers
# Pro Tier: For complex game systems, replication architecture, StateMachines, DataStore wrappers
MODEL_TIER_PRO=gemini-2.5-pro

# Fast Tier: For rapid UI iterations, animation tweaks, utility scripts, small components
MODEL_TIER_FAST=gemini-2.5-flash

# Local Server Network Configuration
HOST=127.0.0.1
PORT=8000
